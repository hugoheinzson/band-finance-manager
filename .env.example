# Bearer-Token für /mcp (z. B. `openssl rand -hex 32`). Muss zum Token im MCP-Client/Aggregator passen.
BANDMANAGER_API_TOKEN=change-me
# Anzeige im Frontend und in den MCP-Instructions
BANDMANAGER_BAND_NAME=Meine Band
# Unterschrift unter Erinnerungs-Textvorschlägen (leer = keine)
BANDMANAGER_SENDER_NAME=
# Auf welcher Host-Adresse Port 8019 lauscht: 127.0.0.1 (nur lokal / Reverse-Proxy) oder 0.0.0.0 (LAN/VPN, kein Login!)
BANDMANAGER_BIND=127.0.0.1
# Datenverzeichnis auf dem Host (SQLite)
BANDMANAGER_DATA=~/band-manager-data
TZ=Europe/Berlin

# --- Backup (deploy/backup.sh, siehe deploy/RESTORE.md) ---
# lokales Backup-Verzeichnis (Default: $BANDMANAGER_DATA/backup)
BANDMANAGER_BACKUP_DIR=
# rclone-Ziel – UNBEDINGT ein crypt-Remote, die Daten enthalten Namen/IBANs. Leer = kein Upload
BANDMANAGER_RCLONE_REMOTE=
# Ordner für CSVs ohne Kontaktdaten (z. B. ein Dropbox-Ordner). Leer = aus
BANDMANAGER_PUBLIC_EXPORT_DIR=
# SMTP-Config (KEY=VALUE: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, MAIL_FROM, MAIL_TO) für Fehler-Mails. Leer = nur Log
BANDMANAGER_MAIL_CONFIG=
BANDMANAGER_KEEP_DAILY=14
BANDMANAGER_KEEP_MONTHLY_DAYS=730

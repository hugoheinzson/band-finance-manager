# Bearer-Token für /mcp (z. B. `openssl rand -hex 32`). Muss zum Token im MCP-Client/Aggregator passen.
BANDMANAGER_API_TOKEN=change-me
# Anzeige im Frontend und in den MCP-Instructions
BANDMANAGER_BAND_NAME=Meine Band
# Unterschrift unter Erinnerungs-Textvorschlägen (leer = keine)
BANDMANAGER_SENDER_NAME=
# Auf welcher Host-Adresse Port 8019 lauscht: 127.0.0.1 (nur lokal / Reverse-Proxy) oder 0.0.0.0 (LAN/VPN, kein Login!)
BANDMANAGER_BIND=127.0.0.1
# Datenverzeichnis auf dem Host (SQLite)
BANDMANAGER_DATA=~/band-manager-data
TZ=Europe/Berlin
